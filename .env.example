# این فایل رو کپی کن و اسم کپی رو بذار .env  (فایل .env هیچ‌وقت نباید توی گیت‌هاب آپلود بشه)

# ===== انتخاب سرویس: gemini (پیش‌فرض) یا openai (هر سرویس سازگار با OpenAI) =====
LLM_PROVIDER=gemini

# ----- اگه از Gemini استفاده می‌کنی -----
# کلید API گوگل: وارد https://aistudio.google.com/ شو و از «Get API key» بگیر
# (کلیدهای جدید با AQ. شروع می‌شن و قدیمی‌ها با AIza؛ هر دو درستن)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ----- اگه از سرویس سازگار با OpenAI استفاده می‌کنی (LLM_PROVIDER=openai) -----
# آدرس و اسم مدل رو از مستندات سرویس‌دهنده‌ات بخون
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ===== اختیاری =====
# پورت سرور
PORT=3001

# حداکثر تعداد درخواست هر نفر در ۱۰ دقیقه
RATE_LIMIT_MAX=40

# اگه سرور برای رسیدن به سرویس به پروکسی نیاز داره (README بخش «اگه سرور به سرویس نمی‌رسه»)
# LLM_PROXY=http://127.0.0.1:10809

# چند میلی‌ثانیه منتظر شروع جواب بمونه (پیش‌فرض ۳۰۰۰۰)
# LLM_TIMEOUT_MS=30000
