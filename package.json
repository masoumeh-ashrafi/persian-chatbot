{
  "name": "persian-chatbot",
  "version": "1.0.0",
  "description": "چت‌بات فارسی با React و Express و Gemini، همراه با حالت آموزشی",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.11"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "dotenv": "^18.0.7",
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^6.29.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "vite": "^5.4.21"
  }
}
